# Wayground Pro Automator - Example Environment Configuration
# Copy this file to .env and configure your keys:
#   cp .env.example .env

# AI Solver (Default: Groq OpenAI-compatible endpoint with Qwen 27B)
# Get a free fast key from: https://console.groq.com/keys
OPENAI_API_KEY=your_groq_or_openai_api_key_here
OPENAI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b

# Optional dedicated key for GPT-OSS 120B / 20B menu presets on Groq.
# Also works alongside a personal API hosted by a different provider.
# GROQ_API_KEY=your_groq_api_key_here

# Mistral AI (Optional legacy fallback)
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=ministral-14b-latest

# AI Gateway
AI_GATEWAY_URL="https://wayground-ai-gateway.<your-account>.workers.dev"
